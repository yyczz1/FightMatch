  "addressedInSource": [
    {
      "finding": "r4211058182",
      "change": "Existing targets use Darwin RENAME_SWAP to retain the actually displaced value, then compare it with prior. A matching prior stays in the existing phase staging slot. A conflict is marked before identity inspection and blocks later automatic restore of that path. The first foreign value is retained in displaced; exactly one swap attempts its return. A second foreign value is retained in conflict and the operation remains failed. No ordinary os.replace or additional commit-check pretending to be CAS remains.",
      "boundedOutcomeOnSecondDrift": "P holds the first returned concurrent value; the later displaced concurrent value is preserved in the exact conflict leaf. Original preimage stays in restore/source. Report failure, do not loop or silently claim baseline restoration.",
      "maxSwapCallsPerAttempt": 2,
      "returnAttemptsMax": 1
    },
    {
      "finding": "r4211058192",
      "change": "register collects and validates argv/cwd/cwdProbeExit before one owned dictionary publication. Details failure leaves no entry and preserves already valid ownership. Fresh supplied snapshots can rediscover the child; the original failure remains recorded."
    }
  ],
