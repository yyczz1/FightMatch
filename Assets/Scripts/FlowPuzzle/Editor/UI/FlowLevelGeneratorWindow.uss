.field-row { flex-direction: row; align-items: center; margin-top: 4px; }
.field-row Label { width: 120px; }
.field-row * { margin-right: 4px; }
.foldout-section { margin-top: 8px; }
.action-bar { flex-direction: row; margin-top: 8px; }
.action-bar Button { margin-right: 6px; }
#board-container { min-height: 200px; }
