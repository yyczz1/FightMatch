    },
    {
      "key": "fm.victory.playback.skip_button",
      "screen": "victory_pending",
      "element": "button",
      "stateOrTrigger": "final_playback_pending",
      "texts": {
        "en": "Skip Final Sequence",
        "zh-Hans": "跳过末段表现"
      },
      "parameters": [],
      "severity": "info",
