    {
      "key": "fm.victory.settle.button",
      "screen": "victory_pending",
      "element": "button",
      "stateOrTrigger": "base_settlement_available",
      "texts": {
        "en": "Continue to Base Rewards",
        "zh-Hans": "继续基础奖励结算"
      },
      "parameters": [],
