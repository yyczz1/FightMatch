{
  "schemaVersion": 1,
  "locales": [
    "en",
    "zh-Hans"
  ],
  "entries": [
    {
      "key": "fm.battle.action.accepted",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "valid_path_submitted_once",
      "texts": {
        "en": "Action submitted.",
        "zh-Hans": "行动已提交。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "同一手势只出现一次。"
    },
    {
      "key": "fm.battle.enemy.numbered_name",
      "screen": "battle",
      "element": "display_name_template",
      "stateOrTrigger": "same_enemy_definition_needs_instance_distinction",
      "texts": {
        "en": "{enemyName} {enemyNumber}",
        "zh-Hans": "{enemyName} {enemyNumber}"
      },
      "parameters": [
        "enemyName",
        "enemyNumber"
      ],
      "severity": "info",
      "qaNotes": "L1 EnemyInstanceKey A/B 分别以 OriginalSlot+1 显示为 1/2；A、B、PairId 与 FaceId 不进入玩家文案。"
    },
    {
      "key": "fm.battle.enemy.vulnerable",
      "screen": "battle",
      "element": "status",
      "stateOrTrigger": "enemy_next_action_vulnerability_active",
      "texts": {
        "en": "Vulnerable (Next Action)",
        "zh-Hans": "易伤（下一次行动）"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "仅真实易伤窗口有效时显示；下一完整有效玩家行动即到期，不等待下一次击中核心。"
    },
    {
      "key": "fm.battle.exit.confirm_button",
      "screen": "battle_management",
      "element": "button",
      "stateOrTrigger": "exit_battle_previewed",
      "texts": {
        "en": "Exit This Battle",
        "zh-Hans": "确认退出本局"
      },
      "parameters": [],
      "severity": "warning",
      "qaNotes": "必须在预览后才可提交。"
    },
    {
      "key": "fm.battle.exit.preview_body",
      "screen": "battle_management",
      "element": "dialog_body",
      "stateOrTrigger": "exit_battle_requested",
      "texts": {
        "en": "This ends the current attempt and returns to the map. It will not start a new battle or grant rewards for this attempt.",
        "zh-Hans": "将结束当前尝试并返回地图。不会自动开始新战斗，也不会发放本局奖励。"
      },
      "parameters": [],
      "severity": "warning",
      "qaNotes": "不等同关闭应用。"
    },
    {
      "key": "fm.battle.exit.preview_title",
      "screen": "battle_management",
      "element": "dialog_title",
      "stateOrTrigger": "exit_battle_requested",
      "texts": {
        "en": "Exit This Battle?",
        "zh-Hans": "退出本局？"
      },
      "parameters": [],
      "severity": "warning",
      "qaNotes": "明确对象是当前战斗。"
    },
    {
      "key": "fm.battle.gesture.cancelled",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "pointer_cancelled",
      "texts": {
        "en": "Path canceled. No action was submitted.",
        "zh-Hans": "连线已取消，未提交行动。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "覆盖系统取消与主动取消。"
    },
    {
      "key": "fm.battle.gesture.crossed",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "path_crosses_locked_route",
      "texts": {
        "en": "The path cannot cross an existing path.",
        "zh-Hans": "路线不能与已有路线交叉。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "零提交。"
    },
    {
      "key": "fm.battle.gesture.focus_lost",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "input_focus_lost",
      "texts": {
        "en": "Path interrupted. No action was submitted.",
        "zh-Hans": "连线已中止，未提交行动。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "失焦、页面失活均不得提交。"
    },
    {
      "key": "fm.battle.gesture.instruction",
      "screen": "battle",
      "element": "instruction",
      "stateOrTrigger": "ready_for_input",
      "texts": {
        "en": "Start at a colored endpoint and drag through adjacent horizontal or vertical cells to its matching endpoint.",
        "zh-Hans": "从同色端点开始，沿横竖相邻格拖到配对端点。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "不暗示需要铺满棋盘。"
    },
    {
      "key": "fm.battle.gesture.invalid_start",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "pointer_started_off_endpoint",
      "texts": {
        "en": "Start the path from an endpoint.",
        "zh-Hans": "请从端点开始连线。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "松手不提交行动。"
    },
    {
      "key": "fm.battle.gesture.not_adjacent",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "path_skips_cell",
      "texts": {
        "en": "Paths can only move through adjacent horizontal or vertical cells.",
        "zh-Hans": "只能连接横竖相邻的格子。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "不改变已提交历史。"
    },
    {
      "key": "fm.battle.gesture.playback_locked",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "presentation_lock_active",
      "texts": {
        "en": "Battle playback is in progress. Skip to the current state to continue.",
        "zh-Hans": "战斗表现播放中。可跳到当前战局后继续操作。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "不得在完整反馈门关闭前提交下一行动。"
    },
    {
      "key": "fm.battle.gesture.second_pointer_ignored",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "second_pointer_added",
      "texts": {
        "en": "The second touch was ignored. Continue with the original touch.",
        "zh-Hans": "已忽略第二个触点，请继续使用原触点。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "首指身份稳定，第二指不抢占。"
    },
    {
      "key": "fm.battle.gesture.wrong_endpoint",
      "screen": "battle",
      "element": "feedback",
      "stateOrTrigger": "path_ends_at_wrong_endpoint",
      "texts": {
        "en": "Connect to the matching endpoint of the same color.",
        "zh-Hans": "请连接到同色的配对端点。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "零提交。"
    },
    {
      "key": "fm.battle.hud.enemy_hp",
      "screen": "battle",
      "element": "hud_label",
      "stateOrTrigger": "battle_active",
      "texts": {
        "en": "{enemyName}  {currentHp}/{maxHp}",
        "zh-Hans": "{enemyName}  {currentHp}/{maxHp}"
      },
      "parameters": [
        "currentHp",
        "enemyName",
        "maxHp"
      ],
      "severity": "info",
      "qaNotes": "敌人名由独立本地化键解析。"
    },
    {
      "key": "fm.battle.hud.enemy_intent",
      "screen": "battle",
      "element": "hud_label",
      "stateOrTrigger": "enemy_intent_visible",
      "texts": {
        "en": "Intent: {intentName}",
        "zh-Hans": "意图：{intentName}"
      },
      "parameters": [
        "intentName"
      ],
      "severity": "info",
      "qaNotes": "不显示内部意图枚举。"
    },
    {
      "key": "fm.battle.hud.member_hp",
      "screen": "battle",
      "element": "hud_label",
      "stateOrTrigger": "battle_active",
      "texts": {
        "en": "{characterName}  {currentHp}/{maxHp}",
        "zh-Hans": "{characterName}  {currentHp}/{maxHp}"
      },
      "parameters": [
        "characterName",
        "currentHp",
        "maxHp"
      ],
      "severity": "info",
      "qaNotes": "角色名、生命值均由当前战斗只读视图提供。"
    },
    {
      "key": "fm.battle.hud.phase",
      "screen": "battle",
      "element": "hud_label",
      "stateOrTrigger": "battle_active",
      "texts": {
        "en": "Phase {currentPhase}/{totalPhases}",
        "zh-Hans": "阶段 {currentPhase}/{totalPhases}"
      },
      "parameters": [
        "currentPhase",
        "totalPhases"
      ],
      "severity": "info",
      "qaNotes": "L1 当前应为单阶段；键可复用同一产品后续内容。"
    },
    {
      "key": "fm.battle.intent.charge",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "enemy_intent_Charge_visible",
      "texts": {
        "en": "Charge",
        "zh-Hans": "蓄力"
      },
      "parameters": [],
      "severity": "warning",
      "qaNotes": "非固定 L1 发布意图；仅真实 Charge 状态或批准测试夹具可用。"
    },
    {
      "key": "fm.battle.intent.defeated",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "enemy_hp_reaches_zero",
      "texts": {
        "en": "Defeated",
        "zh-Hans": "已击倒"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "由敌人 HP=0 的显示状态选择，不映射 EnemyIntentKind；替换播放帧中的硬编码文本。"
    },
    {
      "key": "fm.battle.intent.heavy",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "enemy_heavy_strike_intent_visible",
      "texts": {
        "en": "Heavy Strike",
        "zh-Hans": "重砸"
      },
      "parameters": [],
      "severity": "warning",
      "qaNotes": "用于真实重砸Strike配置；不另造保存意图枚举，伤害与易伤均读实际规则。"
    },
    {
      "key": "fm.battle.intent.ranged",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "enemy_ranged_strike_intent_visible",
      "texts": {
        "en": "Ranged Attack",
        "zh-Hans": "远程攻击"
      },
      "parameters": [],
      "severity": "warning",
      "qaNotes": "用于真实远程Strike配置；不另造保存意图枚举，不改变范围或目标规则。"
    },
    {
      "key": "fm.battle.intent.rest",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "enemy_intent_Rest_visible",
      "texts": {
        "en": "Rest",
        "zh-Hans": "休整"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "映射实际Rest意图，不借用Charge名称。"
    },
    {
      "key": "fm.battle.intent.strike",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "enemy_intent_Strike_visible",
      "texts": {
        "en": "Attack",
        "zh-Hans": "攻击"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "精确映射 EnemyIntentKind.Strike；当前 L1 两名发条步兵唯一发布意图。"
    },
    {
      "key": "fm.battle.intent.wind",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "enemy_intent_Wind_visible",
      "texts": {
        "en": "Wind Up",
        "zh-Hans": "上弦"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "映射实际Wind意图；用尽后按真实fallback显示，不从名称推断恢复或扣次。"
    },
    {
      "key": "fm.battle.member.select_prompt",
      "screen": "battle",
      "element": "instruction",
      "stateOrTrigger": "no_member_selected",
      "texts": {
        "en": "Select a living party member first.",
        "zh-Hans": "先选择一名存活成员。"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "当前仅战士可选。"
    },
    {
      "key": "fm.battle.member.selected",
      "screen": "battle",
      "element": "status",
      "stateOrTrigger": "member_selected",
      "texts": {
        "en": "Acting: {characterName}",
        "zh-Hans": "当前行动：{characterName}"
      },
      "parameters": [
        "characterName"
      ],
      "severity": "info",
      "qaNotes": "选择与画线颜色须一致。"
    },
    {
      "key": "fm.battle.phase.await_action",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "battle_phase_AwaitAction_visible",
      "texts": {
        "en": "Awaiting Action",
        "zh-Hans": "等待行动"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "精确映射 BattlePhase.AwaitAction；当前 L1 开局及首个有效行动后可达。"
    },
    {
      "key": "fm.battle.phase.await_links",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "battle_phase_AwaitLinks_visible",
      "texts": {
        "en": "Awaiting Route Links",
        "zh-Hans": "等待补充路线"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "非固定 L1 正常链；供现有批准的多阶段可见测试和未来真实发布内容使用。"
    },
    {
      "key": "fm.battle.phase.await_rescue",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "battle_phase_AwaitRescue_visible",
      "texts": {
        "en": "Awaiting Rescue",
        "zh-Hans": "等待救援"
      },
      "parameters": [],
      "severity": "warning",
      "qaNotes": "全员倒下且业务进入 AwaitRescue 时使用；不宣称战斗已经关闭。"
    },
    {
      "key": "fm.battle.phase.closed",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "battle_phase_Closed_visible",
      "texts": {
        "en": "Battle Closed",
        "zh-Hans": "战斗已结束"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "只映射已结束阶段；不等同已结算奖励。"
    },
    {
      "key": "fm.battle.phase.label",
      "screen": "battle",
      "element": "hud_label",
      "stateOrTrigger": "business_battle_phase_visible",
      "texts": {
        "en": "Battle state: {phaseName}",
        "zh-Hans": "战斗状态：{phaseName}"
      },
      "parameters": [
        "phaseName"
      ],
      "severity": "info",
      "qaNotes": "phaseName 只能来自本表明确 BattlePhase 映射，不得使用 enum.ToString()。"
    },
    {
      "key": "fm.battle.phase.won_pending_settlement",
      "screen": "battle",
      "element": "dynamic_value",
      "stateOrTrigger": "battle_phase_WonPendingSettlement_visible",
      "texts": {
        "en": "Victory Saved — Settlement Pending",
        "zh-Hans": "胜利已保存，待结算"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "精确映射 BattlePhase.WonPendingSettlement；当前 L1 清除第二名敌人后可达。"
    },
    {
      "key": "fm.battle.playback.action_submitted",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "accepted_action_waits_for_playback",
      "texts": {
        "en": "Action submitted. Preparing playback.",
        "zh-Hans": "行动已提交，准备播放"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "当前 L1 每次合法攻击提交后可达；不代表奖励已结算。"
    },
    {
      "key": "fm.battle.playback.beat_row",
      "screen": "battle",
      "element": "playback_label",
      "stateOrTrigger": "ordered_fact_is_playing",
      "texts": {
        "en": "Beat {beatNumber}: {beat}",
        "zh-Hans": "第 {beatNumber} 个反馈：{beat}"
      },
      "parameters": [
        "beat",
        "beatNumber"
      ],
      "severity": "info",
      "qaNotes": "beatNumber 使用玩家侧 1 起序号；不得显示零起 OriginalFactIndex。"
    },
    {
      "key": "fm.battle.playback.critical_hit",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "direct_attack_with_critical",
      "texts": {
        "en": "{characterName} critically hit {enemyName}: {hpBefore} → {hpAfter}",
        "zh-Hans": "{characterName} 暴击 {enemyName}：{hpBefore} → {hpAfter}"
      },
      "parameters": [
        "characterName",
        "enemyName",
        "hpAfter",
        "hpBefore"
      ],
      "severity": "info",
      "qaNotes": "CandidateBattleFactKind.DirectAttack 且 Crit.Triggered=true；L1 战士暴击自然可达。"
    },
    {
      "key": "fm.battle.playback.current_state",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "playback_not_running_or_final_frame",
      "texts": {
        "en": "Current Battle State",
        "zh-Hans": "当前战局"
      },
      "parameters": [],
      "severity": "info",
      "qaNotes": "替换 CandidateBattlePlaybackFrame 的默认硬编码节拍。"
    },
    {
      "key": "fm.battle.playback.direct_hit",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "direct_attack_without_critical",
      "texts": {
        "en": "{characterName} hit {enemyName}: {hpBefore} → {hpAfter}",
        "zh-Hans": "{characterName} 命中 {enemyName}：{hpBefore} → {hpAfter}"
      },
      "parameters": [
        "characterName",
        "enemyName",
        "hpAfter",
        "hpBefore"
      ],
      "severity": "info",
      "qaNotes": "CandidateBattleFactKind.DirectAttack 且 Crit.Triggered=false；名称先由稳定 ID 映射。"
    },
    {
      "key": "fm.battle.playback.enemy_charge",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "enemy_Charge_fact_visible",
      "texts": {
        "en": "{enemyName} began charging.",
        "zh-Hans": "{enemyName} 开始蓄力。"
      },
      "parameters": [
        "enemyName"
      ],
      "severity": "warning",
      "qaNotes": "历史事件使用过去时；不得借用当前意图标签。"
    },
    {
      "key": "fm.battle.playback.enemy_rest",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "committed_enemy_rest_fact_visible",
      "texts": {
        "en": "{enemyName} rested.",
        "zh-Hans": "{enemyName} 休整。"
      },
      "parameters": [
        "enemyName"
      ],
      "severity": "info",
      "qaNotes": "只播放已提交休整事实；enemyName本地化，不额外推进敌方阶段。"
    },
    {
      "key": "fm.battle.playback.enemy_strike",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "enemy_Strike_deals_damage",
      "texts": {
        "en": "{enemyName} attacked {characterName}: {hpBefore} → {hpAfter}",
        "zh-Hans": "{enemyName} 攻击 {characterName}：{hpBefore} → {hpAfter}"
      },
      "parameters": [
        "characterName",
        "enemyName",
        "hpAfter",
        "hpBefore"
      ],
      "severity": "info",
      "qaNotes": "CandidateBattleFactKind.EnemyIntent 且 EnemyIntentKind.Strike、Damage 非空；当前 L1 首次击倒前一名敌人后由存活敌人触发。"
    },
    {
      "key": "fm.battle.playback.face_changed",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "committed_face_change_fact_visible",
      "texts": {
        "en": "Entered board {faceNumber}.",
        "zh-Hans": "进入第 {faceNumber} 面。"
      },
      "parameters": [
        "faceNumber"
      ],
      "severity": "info",
      "qaNotes": "faceNumber使用玩家可见的一起始面序号；只播放已提交翻面，不另发奖励或推进敌方行动。"
    },
    {
      "key": "fm.battle.playback.interrupted",
      "screen": "battle",
      "element": "warning",
      "stateOrTrigger": "playback_scheduler_failed_and_latest_state_is_shown",
      "texts": {
        "en": "Playback was interrupted. The latest battle state is now shown. Diagnostic code: {errorCode}",
        "zh-Hans": "表现播放已中断，现已显示最新战局。诊断码：{errorCode}"
      },
      "parameters": [
        "errorCode"
      ],
      "severity": "warning",
      "qaNotes": "不得显示异常文本，也不得把表现故障写成保存失败。"
    },
    {
      "key": "fm.battle.playback.penetrating_hit",
      "screen": "battle",
      "element": "playback_beat",
      "stateOrTrigger": "ordinary_magic_hit_with_arcane_penetration",
      "texts": {
        "en": "{characterName} hit {enemyName} with Arcane Penetration: {hpBefore} → {hpAfter}",
        "zh-Hans": "{characterName} 奥术穿透命中 {enemyName}：{hpBefore} → {hpAfter}"
      },
      "parameters": [
        "characterName",
        "enemyName",
        "hpAfter",
        "hpBefore"
      ],
      "severity": "info",
      "qaNotes": "仅播放已提交的普通魔攻穿透触发事实；穿透修正本次魔防，不用于物防、火球或DOT，显示实际HP前后值。"
    },
    {
