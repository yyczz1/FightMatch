    },
    {
      "key": "fm.victory.playback_pending",
      "screen": "victory_pending",
      "element": "status",
      "stateOrTrigger": "final_playback_pending",
      "texts": {
        "en": "The final sequence is still playing. You can watch it or skip the presentation.",
        "zh-Hans": "末段表现尚未完成。可继续观看或跳过表现。"
