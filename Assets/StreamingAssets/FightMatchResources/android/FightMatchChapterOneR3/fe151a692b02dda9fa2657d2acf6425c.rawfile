      "qaNotes": "唯一开放结算的按钮。"
    },
    {
      "key": "fm.victory.settle.unavailable",
      "screen": "victory_pending",
      "element": "notice",
      "stateOrTrigger": "base_settlement_not_available",
      "texts": {
        "en": "Rewards are not ready to settle: {reason}",
        "zh-Hans": "暂时无法结算：{reason}"
      },
      "parameters": [
        "reason"
